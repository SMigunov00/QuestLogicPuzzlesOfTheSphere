  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0423\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0439 \u0438\u0433\u0440\u043E\u043A,
    \u0445\u043E\u0447\u0443 \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C \u0432\u0430\u043C
    \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0438\u0435 \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u044F
    \u0437\u0430 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u0445
    \u0434\u0430\u043D\u043D\u044B\u0445 \u0441 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u043C\u0438
    \u0443\u0440\u043E\u0432\u043D\u044F\u043C\u0438, \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u0443\u044E
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\u043C\u0438 \u0432 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0445
    \u0443\u0440\u043E\u0432\u043D\u044F\u0445. \u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u0437\u0430
    \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0438\u0435 \u043D\u0435\u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0430,
    \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E \u0432\u0430\u043C 10
    000 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0438\u044E"
